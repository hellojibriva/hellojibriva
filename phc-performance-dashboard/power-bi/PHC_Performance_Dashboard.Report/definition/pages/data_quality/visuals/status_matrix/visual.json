{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.2.0/schema.json",
  "name": "status_matrix",
  "position": {
    "x": 16,
    "y": 184,
    "z": 9000,
    "height": 528,
    "width": 816,
    "tabOrder": 9000
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Facility"
                    }
                  },
                  "Property": "Facility Code"
                }
              },
              "queryRef": "Facility.Facility Code",
              "nativeQueryRef": "Facility Code",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Month"
                    }
                  },
                  "Property": "Month Short"
                }
              },
              "queryRef": "Month.Month Short",
              "nativeQueryRef": "Month Short",
              "active": true
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Reports"
                    }
                  },
                  "Property": "Report Status"
                }
              },
              "queryRef": "Reports.Report Status",
              "nativeQueryRef": "Report Status"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Report status by facility and month (✓ received · ⚠ flagged · ✗ missing)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
