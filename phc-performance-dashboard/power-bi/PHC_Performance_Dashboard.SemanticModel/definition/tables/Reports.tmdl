		lineageTag: 5924e43d-a13d-5d1a-b729-fbf3877d6580

	measure IPT1 = SUM ( Reports[ipt1] )
		formatString: #,0
		displayFolder: 3 Antenatal care
		lineageTag: f9f8f5e2-1de3-5a65-8f44-07cc9fd4cb4c

	measure IPT2 = SUM ( Reports[ipt2] )
		formatString: #,0
		displayFolder: 3 Antenatal care
		lineageTag: d042f671-debd-5b97-891a-3a18b102fc79

	measure IPT3 = SUM ( Reports[ipt3] )
		formatString: #,0
		displayFolder: 3 Antenatal care
		lineageTag: 64b2d45f-8077-54d7-917c-96815109363d

	measure 'ANC4 Retention' = DIVIDE ( [ANC4], [ANC1] )
		formatString: 0%
		displayFolder: 3 Antenatal care
		lineageTag: 6e02caee-a967-5eca-837d-8b8cca97f54c

	measure 'ANC8 Retention' = DIVIDE ( [ANC8], [ANC1] )
		formatString: 0%
		displayFolder: 3 Antenatal care
		lineageTag: d2c5c5d3-9871-51e1-9371-b806db5d3f90

	measure 'IPTp3 Completion' = DIVIDE ( [IPT3], [IPT1] )
		formatString: 0%
		displayFolder: 3 Antenatal care
		lineageTag: 6207e710-ae36-52bb-bc46-20ce860711f4

	measure 'ANC Cascade' = ```
			SWITCH (
			    SELECTEDVALUE ( 'ANC Step'[Step] ),
			    "ANC1", [ANC1],
			    "ANC4", [ANC4],
			    "ANC8", [ANC8]
			)
			```
		formatString: #,0
		displayFolder: 3 Antenatal care
		lineageTag: 9f03a46c-b0f1-5f86-8881-dd3000815b02

	measure 'IPTp Cascade' = ```
			SWITCH (
			    SELECTEDVALUE ( 'IPTp Step'[Step] ),
			    "IPT1", [IPT1],
			    "IPT2", [IPT2],
			    "IPT3", [IPT3]
			)
			```
		formatString: #,0
		displayFolder: 3 Antenatal care
		lineageTag: 3973de5f-281f-59f7-93ab-a2f66e1491d9

	measure 'U5 Tested' = SUM ( Reports[u5_tested] )
		formatString: #,0
