		lineageTag: 8b404ad8-eb7a-54d3-8006-b88fb3818d20

	measure 'U5 Treated' = SUM ( Reports[u5_treated] )
		formatString: #,0
		displayFolder: 4 Malaria
		lineageTag: bd7e5e51-aab4-5b1e-8837-fd2c158d3ae9

	measure 'Adult Tested' = SUM ( Reports[ad_tested] )
		formatString: #,0
		displayFolder: 4 Malaria
		lineageTag: 448a3e74-d51d-537a-b06e-c93ca402f4dc

	measure 'Adult Positive' = SUM ( Reports[ad_pos] )
		formatString: #,0
		displayFolder: 4 Malaria
		lineageTag: 5265d0ad-d9a3-55ac-a0fd-a038b190f058

	measure 'Adult Treated' = SUM ( Reports[ad_treated] )
		formatString: #,0
		displayFolder: 4 Malaria
		lineageTag: 6be90b9a-26eb-56b4-aeab-f4e2fc66a5e6

	measure 'U5 Positivity' = DIVIDE ( [U5 Positive], [U5 Tested] )
		formatString: 0%
		displayFolder: 4 Malaria
		lineageTag: ff69d139-3e2a-5953-8dba-ba218f12f4a1

	measure 'Adult Positivity' = DIVIDE ( [Adult Positive], [Adult Tested] )
		formatString: 0%
		displayFolder: 4 Malaria
		lineageTag: 40ee09a3-55ff-5992-9f3a-6025d64ed732

	measure 'U5 Treatment Coverage' = DIVIDE ( [U5 Treated], [U5 Positive] )
		formatString: 0%
		displayFolder: 4 Malaria
		lineageTag: 571bef51-fd22-5057-80d2-bbdeb8e75cf7

	measure 'Adult Treatment Coverage' = DIVIDE ( [Adult Treated], [Adult Positive] )
		formatString: 0%
		displayFolder: 4 Malaria
		lineageTag: 758dc705-b7b6-5364-b649-32869855666d

	measure 'Malaria Cases' = ```
			VAR _Group = SELECTEDVALUE ( 'Malaria Step'[Group] )
			VAR _Step = SELECTEDVALUE ( 'Malaria Step'[Step] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _Group = "Under 5" && _Step = "Tested", [U5 Tested],
			        _Group = "Under 5" && _Step = "Positive", [U5 Positive],
			        _Group = "Under 5" && _Step = "Treated", [U5 Treated],
			        _Group = "Adults" && _Step = "Tested", [Adult Tested],
			        _Group = "Adults" && _Step = "Positive", [Adult Positive],
			        _Group = "Adults" && _Step = "Treated", [Adult Treated]
			    )
			```
		formatString: #,0
		displayFolder: 4 Malaria
		lineageTag: 62d6f4c2-91b7-592b-9ee2-38fb36bd39ad

	measure 'FP Counselled' = SUM ( Reports[fp_counselled] )
		formatString: #,0
		displayFolder: 5 Family planning
		lineageTag: 3f3c74e6-57d3-5fb4-9514-bf7b275a5295

	measure 'FP Acceptors' = SUM ( Reports[fp_acceptors] )
		formatString: #,0
		displayFolder: 5 Family planning
		lineageTag: 99e8ac14-6e28-5795-b091-55f5cea4115c

	measure 'FP Acceptance' = DIVIDE ( [FP Acceptors], [FP Counselled] )
		formatString: 0%
		displayFolder: 5 Family planning
		lineageTag: fd1954a1-0e8f-574a-9061-f952a6c270a0

	/// Acceptors with a method recorded. Lower than FP Acceptors because many reports omit the breakdown.
	measure 'FP Method Total' = SUM ( Reports[fp_injectables] ) + SUM ( Reports[fp_male_condom] ) + SUM ( Reports[fp_implants] ) + SUM ( Reports[fp_pills] ) + SUM ( Reports[fp_female_condom] ) + SUM ( Reports[fp_iud] )
		formatString: #,0
		displayFolder: 5 Family planning
		lineageTag: a4ac07b0-3bc2-577e-8c72-4b919e854b1d

	measure 'FP Method Acceptors' = ```
			SWITCH (
			    SELECTEDVALUE ( 'FP Method'[Method] ),
			    "Injectables", SUM ( Reports[fp_injectables] ),
			    "Male condoms", SUM ( Reports[fp_male_condom] ),
			    "Implants", SUM ( Reports[fp_implants] ),
			    "Pills", SUM ( Reports[fp_pills] ),
			    "Female condoms", SUM ( Reports[fp_female_condom] ),
			    "IUD", SUM ( Reports[fp_iud] )
			)
			```
		formatString: #,0
		displayFolder: 5 Family planning
		lineageTag: 31ff1eba-67dc-534f-9ff9-dd408e97f73a

	measure 'FP Method Share' = DIVIDE ( [FP Method Acceptors], [FP Method Total] )
		formatString: 0%
		displayFolder: 5 Family planning
		lineageTag: de824a24-a6ce-54d1-affb-95ac604da554

	measure 'Infant Deaths' = SUM ( Reports[deaths_infant] )
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: fc933dcc-fb7b-5c6b-a42d-4b29c8a3273e

	measure 'Under-5 Deaths' = SUM ( Reports[deaths_u5] )
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: d98d38f7-3d18-53ac-992f-9691493d5448

	measure 'Neonatal Deaths' = SUM ( Reports[deaths_neonatal] )
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: 1f2ea7d0-b850-5bee-aef5-8f89f129af6e

	measure 'Maternal Deaths' = SUM ( Reports[deaths_maternal] )
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: e75f1edd-c6ed-589c-a4a6-7d45baf1d25e

	/// Sum of the four separately reported death fields.
	measure 'Reported Deaths' = [Infant Deaths] + [Under-5 Deaths] + [Neonatal Deaths] + [Maternal Deaths]
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: cd6356ed-48da-546d-98d3-d4142e46f1b8

	measure 'Deaths by Category' = ```
			SWITCH (
			    SELECTEDVALUE ( 'Death Category'[Category] ),
			    "Infant", [Infant Deaths],
			    "Under-5", [Under-5 Deaths],
			    "Neonatal", [Neonatal Deaths],
			    "Maternal", [Maternal Deaths]
			)
			```
		formatString: #,0
		displayFolder: 6 Mortality
		lineageTag: 2c1f3d2c-2d0f-5953-8845-0d5e292e4cdd

	measure 'Reports Answering' = CALCULATE ( [Reports Received], Reports[Challenge Status] <> "not_answered" )
		formatString: #,0
		displayFolder: 7 Barriers
		lineageTag: 1882964c-75b3-5f08-943c-1852533cfe75

	measure 'Reports Naming a Challenge' = CALCULATE ( [Reports Received], Reports[Challenge Status] = "challenge" )
		formatString: #,0
		displayFolder: 7 Barriers
		lineageTag: 1ff7bc74-9f1f-5587-a34d-06068120ef83

	measure 'Challenge Share' = DIVIDE ( [Reports Naming a Challenge], [Reports Answering] )
		formatString: 0%
		displayFolder: 7 Barriers
		lineageTag: 06b41a96-cf06-52fd-9911-c838d5a47cab

	measure 'Theme Mentions' = COUNTROWS ( 'Challenge Themes' )
		formatString: #,0
		displayFolder: 7 Barriers
		lineageTag: 5fe66db8-18ed-5442-96e8-864a6028bbab

	/// Share of reports naming any challenge that mention this theme.
	measure 'Theme Share' = DIVIDE ( [Theme Mentions], [Reports Naming a Challenge] )
		formatString: 0%
		displayFolder: 7 Barriers
		lineageTag: 9d90e50e-f1d2-506e-b58c-80a222c331d5

	/// Reports failing at least one consistency or outlier check. June volumes are not treated as spikes because of the immunisation outreach.
	measure 'Flagged Reports' = CALCULATE ( [Reports Received], Reports[dq_any] = 1 )
		formatString: #,0
		displayFolder: 8 Data quality
		lineageTag: 926cdf2d-5778-5451-881f-a5c5064c7df5

	measure 'Flagged Share' = DIVIDE ( [Flagged Reports], [Reports Received] )
		formatString: 0.0%
		displayFolder: 8 Data quality
		lineageTag: 7fe86d50-eb58-51a8-a17e-02a291d7b1d0

	measure 'Reports Failing Check' = ```
			SWITCH (
			    SELECTEDVALUE ( 'DQ Check'[Check] ),
			    "Zone entered inconsistently", CALCULATE ( [Reports Received], Reports[dq_zone_mismatch] = 1 ),
			    "More positives than tests", CALCULATE ( [Reports Received], Reports[dq_pos_gt_tested] = 1 ),
			    "More treated than confirmed", CALCULATE ( [Reports Received], Reports[dq_treated_gt_pos] = 1 ),
			    "More FP acceptors than counselled", CALCULATE ( [Reports Received], Reports[dq_fp_acc_gt_counselled] = 1 ),
			    "Attendance spike (not June)", CALCULATE ( [Reports Received], Reports[dq_spike_attendance] = 1 ),
			    "Immunisation spike (not June)", CALCULATE ( [Reports Received], Reports[dq_spike_immunisation] = 1 ),
			    "FP method breakdown missing", CALCULATE ( [Reports Received], Reports[dq_fp_no_method] = 1 )
			)
			```
		formatString: #,0
		displayFolder: 8 Data quality
		lineageTag: 60fff66b-dac1-5e8a-91c7-95204c12948a

	/// Matrix cell status: report received, flagged by a check, or missing.
	measure 'Report Status' = ```
			VAR _Reports = [Reports Received]
			VAR _Flagged = [Flagged Reports]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Reports ), "✗ missing",
			        _Flagged > 0, "⚠ flagged",
			        "✓"
			    )
			```
		displayFolder: 8 Data quality
		lineageTag: b03429da-824d-5d96-8019-ea140166f588

		annotation PBI_FormatHint = {"isText":true}

	measure Headline = ```
			VAR _Pos = FORMAT ( [U5 Positivity], "0%" )
			VAR _Drop = FORMAT ( 1 - [ANC4 Retention], "0%" )
			VAR _Comp = FORMAT ( [Reporting Completeness], "0.0%" )
			RETURN
			    _Pos & " of under-5 malaria tests are positive. "
			        & _Drop & " of women who start ANC do not reach a fourth visit. "
			        & _Comp & " of expected monthly reports were received."
			
			```
		displayFolder: 0 Headline
		lineageTag: f1457e31-8452-552a-873c-f76085d358a4

		annotation PBI_FormatHint = {"isText":true}

