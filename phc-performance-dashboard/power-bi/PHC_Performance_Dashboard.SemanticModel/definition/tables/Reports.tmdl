table Reports
	lineageTag: 18816857-e7be-5660-9018-c4361662aa6b

	/// Facility-month reports received.
	measure 'Reports Received' = COUNTROWS ( Reports )
		formatString: #,0
		displayFolder: 1 Coverage
		lineageTag: e43c9e0c-dd44-5cbb-b8fd-479e4500ceaf

	measure 'Facilities Reporting' = DISTINCTCOUNT ( Reports[Facility Code] )
		formatString: #,0
		displayFolder: 1 Coverage
		lineageTag: 1813932b-3b45-560b-88c2-2537bf550e9f

	measure 'Facilities in Scope' = COUNTROWS ( Facility )
		formatString: #,0
		displayFolder: 1 Coverage
		lineageTag: feb036d2-3d30-573f-a173-2457be91f503

	/// Facilities in the selection multiplied by months in the selection.
	measure 'Expected Reports' = COUNTROWS ( Facility ) * COUNTROWS ( 'Month' )
		formatString: #,0
		displayFolder: 1 Coverage
		lineageTag: 09c4b0d4-efdb-5508-bef3-f075a25db0f8

	measure 'Reporting Completeness' = DIVIDE ( [Reports Received], [Expected Reports] )
		formatString: 0.0%
		displayFolder: 1 Coverage
		lineageTag: 28142d69-f510-56f7-ba9c-293da38e4313

	measure 'Patients Seen' = SUM ( Reports[gen_att] )
