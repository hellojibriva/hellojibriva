		lineageTag: 9928a780-a4cc-58a3-b84d-e60d34d6facf

	measure 'OPD Share' = DIVIDE ( [OPD Attendance], [Patients Seen] )
		formatString: 0%
		displayFolder: 2 Service volume
		lineageTag: bf963fbb-d0af-50bb-801c-575948204e87

	/// Antigen doses to children under 1 (BCG, Penta 1-3, Vitamin A, MCV1). June includes the immunisation outreach.
	measure 'Immunisation Doses' = SUM ( Reports[imm_doses_u1] )
		formatString: #,0
