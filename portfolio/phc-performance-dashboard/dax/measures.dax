// Primary Healthcare Performance & Service Delivery Analytics – DAX measures
// Generated by scripts/build_model_assets.py. Tabular Editor DAX-script syntax: in Tabular Editor use File > Open > DAX script,
// or copy each expression into Power BI Desktop (Modeling > New measure) on the 'Measures' table.

MEASURE 'Measures'[Service Value] =
    SUM ( 'FactServiceDelivery'[Value] )
    , FormatString = "#,##0"
    , DisplayFolder = "0 Base"
    , Description = "Sum of indicator values in the current filter context. Blank when every value is missing (no report / not captured) – never converted to zero."

MEASURE 'Measures'[Values Recorded] =
    COUNT ( 'FactServiceDelivery'[Value] )
    , FormatString = "#,##0"
    , DisplayFolder = "0 Base"
    , Description = "Number of facility-month-indicator cells that hold a value (zeros included)."

MEASURE 'Measures'[General Attendance] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "GEN_ATT" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Service contacts recorded as general attendance (visits, not unique patients). Unaffected by the Service category slicer."

MEASURE 'Measures'[OPD Visits] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "OPD_ATT" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Outpatient department attendance (visits, not unique patients). Unaffected by the Service category slicer."

MEASURE 'Measures'[ANC Visits] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "ANC_TOT" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "All antenatal care contacts recorded (any visit number). Unaffected by the Service category slicer."

MEASURE 'Measures'[ANC First Visits] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "ANC1" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "First antenatal care visits recorded in the period. Unaffected by the Service category slicer."

MEASURE 'Measures'[ANC Fourth Visits] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "ANC4" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Fourth antenatal care visits recorded in the period. Unaffected by the Service category slicer."

MEASURE 'Measures'[ANC Eighth Visits] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "ANC8" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Eighth antenatal care visits recorded in the period. Unaffected by the Service category slicer."

MEASURE 'Measures'[IPTp Dose 1] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "IPT1" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Pregnant women given intermittent preventive treatment dose 1. Unaffected by the Service category slicer."

MEASURE 'Measures'[IPTp Dose 2] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "IPT2" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Pregnant women given IPTp dose 2. Unaffected by the Service category slicer."

MEASURE 'Measures'[IPTp Dose 3] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "IPT3" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Pregnant women given IPTp dose 3. Unaffected by the Service category slicer."

MEASURE 'Measures'[Skilled Birth Deliveries] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "SBA_DEL" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Deliveries recorded as attended by a skilled birth attendant. Unaffected by the Service category slicer."

MEASURE 'Measures'[Immunization Doses <1 Year] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "IMM_FIC" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Source field ""children immunized under 1 year"" = SUM of antigen doses (BCG, Penta 1–3, Vit A, MCV1). Doses, NOT fully immunized children. Unaffected by the Service category slicer."

MEASURE 'Measures'[Children 0-9m Fully Immunized] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "IMM_ALT" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Alternative source field: children 0–9 months recorded as fully immunized. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Clients Counselled] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_COUN" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Family planning clients counselled. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Acceptors] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_ACC" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Family planning acceptors (clients accepting a method). Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Male Condom Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_MCON" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Female Condom Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_FCON" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Pill Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_PILL" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Injectable Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_INJ" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP Implant Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_IMP" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[FP IUD Acceptances] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "FP_IUD" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Method field captured from June 2026 only. Unaffected by the Service category slicer."

MEASURE 'Measures'[U5 Malaria Tests] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_U5_T" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Malaria tests performed on children under 5. Unaffected by the Service category slicer."

MEASURE 'Measures'[U5 Malaria Positive] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_U5_P" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Positive malaria tests among children under 5. Unaffected by the Service category slicer."

MEASURE 'Measures'[U5 Malaria Treated] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_U5_R" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Children under 5 recorded as treated for malaria. Unaffected by the Service category slicer."

MEASURE 'Measures'[Adult Malaria Tests] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_AD_T" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Malaria tests performed on adults. Unaffected by the Service category slicer."

MEASURE 'Measures'[Adult Malaria Positive] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_AD_P" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Positive malaria tests among adults. Unaffected by the Service category slicer."

MEASURE 'Measures'[Adult Malaria Treated] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "MAL_AD_R" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Adults recorded as treated for malaria. Unaffected by the Service category slicer."

MEASURE 'Measures'[Community Outreaches] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "OUTREACH" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Community outreach sessions conducted. Unaffected by the Service category slicer."

MEASURE 'Measures'[Malaria Tests (All Ages)] =
    [U5 Malaria Tests] + [Adult Malaria Tests]
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Under-5 plus adult malaria tests."

MEASURE 'Measures'[Malaria Positive (All Ages)] =
    [U5 Malaria Positive] + [Adult Malaria Positive]
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Under-5 plus adult positive tests."

MEASURE 'Measures'[FP Method Acceptances (All Methods)] =
    CALCULATE ( [Service Value], REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[ServiceCategory] = "Family planning methods" )
    , FormatString = "#,##0"
    , DisplayFolder = "1 Service volumes"
    , Description = "Sum of the six method fields (Jun–Sep only). Can exceed FP Acceptors because a client may accept more than one method."

MEASURE 'Measures'[U5 Malaria Test Positivity %] =
    DIVIDE ( [U5 Malaria Positive], [U5 Malaria Tests] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "Under-5 positive tests ÷ under-5 tests (ratio of sums). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[Adult Malaria Test Positivity %] =
    DIVIDE ( [Adult Malaria Positive], [Adult Malaria Tests] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "Adult positive tests ÷ adult tests. Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[U5 Treated per Positive %] =
    DIVIDE ( [U5 Malaria Treated], [U5 Malaria Positive] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "Under-5 treated ÷ under-5 positive. A record-keeping ratio, not a clinical treatment rate: values above 100% occur where treatments exceed recorded positives (see data-quality check DQ01). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[Adult Treated per Positive %] =
    DIVIDE ( [Adult Malaria Treated], [Adult Malaria Positive] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "Adult treated ÷ adult positive. Can exceed 100% (see DQ02). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[FP Acceptors per Client Counselled %] =
    DIVIDE ( [FP Acceptors], [FP Clients Counselled] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "FP acceptors ÷ clients counselled in the same period (service uptake, not population coverage). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[ANC4 to ANC1 Ratio %] =
    DIVIDE ( [ANC Fourth Visits], [ANC First Visits] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "ANC4 visits ÷ ANC1 visits recorded in the SAME period. Cross-sectional continuation proxy, NOT cohort completion: the women counted differ. Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[ANC8 to ANC1 Ratio %] =
    DIVIDE ( [ANC Eighth Visits], [ANC First Visits] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "ANC8 ÷ ANC1 in the same period (cross-sectional proxy). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[IPTp3 to IPTp1 Ratio %] =
    DIVIDE ( [IPTp Dose 3], [IPTp Dose 1] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "IPTp dose 3 ÷ dose 1 in the same period (cross-sectional proxy). Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[OPD Share of General Attendance %] =
    DIVIDE ( [OPD Visits], [General Attendance] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "OPD visits ÷ general attendance. Computed from aggregated numerator and denominator – never an average of facility percentages."

MEASURE 'Measures'[Malaria Test Positivity % (All Ages)] =
    DIVIDE ( [Malaria Positive (All Ages)], [Malaria Tests (All Ages)] )
    , FormatString = "0.0%"
    , DisplayFolder = "2 Rates (ratio of sums)"
    , Description = "All-age positive tests ÷ all-age tests."

MEASURE 'Measures'[Expected Reports] =
    SUM ( 'FactFacilityReporting'[Expected] )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Facility-months expected to report (60 facilities × months in context)."

MEASURE 'Measures'[Reports Received] =
    SUM ( 'FactFacilityReporting'[Reported] )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Facility-months with a valid submission (a report with zero values counts as received)."

MEASURE 'Measures'[Reports Not Received] =
    [Expected Reports] - [Reports Received]
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Expected facility-months without a submission."

MEASURE 'Measures'[Reporting Completeness %] =
    DIVIDE ( [Reports Received], [Expected Reports] )
    , FormatString = "0.0%"
    , DisplayFolder = "3 Reporting"
    , Description = "Reports received ÷ reports expected. Measures REPORTING, not service coverage or programme effectiveness."

MEASURE 'Measures'[Facilities Expected] =
    CALCULATE ( DISTINCTCOUNT ( 'FactFacilityReporting'[FacilityKey] ), 'FactFacilityReporting'[Expected] = 1 )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Distinct facilities expected to report in the period."

MEASURE 'Measures'[Facilities Reporting] =
    CALCULATE ( DISTINCTCOUNT ( 'FactFacilityReporting'[FacilityKey] ), 'FactFacilityReporting'[Reported] = 1 )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Distinct facilities with at least one report in the period."

MEASURE 'Measures'[Non-response Months Recorded as 0 in Source] =
    CALCULATE ( COUNTROWS ( 'FactFacilityReporting' ), 'FactFacilityReporting'[ReportingStatus] = "Not reported (source recorded 0 under non-response rule)" )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Facility-months the source workbook filled with zeros under its non-response rule. Treated as missing in this model."

MEASURE 'Measures'[Missing Report Months] =
    CALCULATE ( COUNTROWS ( 'FactFacilityReporting' ), 'FactFacilityReporting'[ReportingStatus] = "Not reported (missing)" )
    , FormatString = "#,##0"
    , DisplayFolder = "3 Reporting"
    , Description = "Facility-months with no submission that the source left blank."

MEASURE 'Measures'[General Attendance per Report] =
    DIVIDE ( [General Attendance], [Reports Received] )
    , FormatString = "#,##0.0"
    , DisplayFolder = "3 Reporting"
    , Description = "General attendance ÷ reports received – a reporting-adjusted volume that removes the effect of missing reports."

MEASURE 'Measures'[Indicator Value Completeness %] =
    VAR expected = CALCULATE ( COUNTROWS ( 'FactServiceDelivery' ), 'FactServiceDelivery'[ValueStatus] <> "Not captured on form" )
    VAR complete = CALCULATE ( COUNTROWS ( 'FactServiceDelivery' ), 'FactServiceDelivery'[ValueStatus] IN { "Reported", "Reported zero", "Corrected upstream (documented)" } )
    RETURN DIVIDE ( complete, expected )
    , FormatString = "0.0%"
    , DisplayFolder = "5 Data quality"
    , Description = "Share of expected indicator values (fields on the form for facility-months in context) that were actually reported. Excludes not-yet-captured fields."

MEASURE 'Measures'[Fields Blank in Submitted Reports] =
    CALCULATE ( COUNTROWS ( 'FactServiceDelivery' ), 'FactServiceDelivery'[ValueStatus] = "Field blank in report (0 per source rule)" )
    , FormatString = "#,##0"
    , DisplayFolder = "5 Data quality"
    , Description = "Indicator fields left blank inside a submitted report (source rule recorded 0)."

MEASURE 'Measures'[Data Quality Exceptions] =
    COUNTROWS ( 'FactDataQuality' )
    , FormatString = "#,##0"
    , DisplayFolder = "5 Data quality"
    , Description = "All flagged checks (DQ01–DQ11) in context."

MEASURE 'Measures'[Logical Inconsistency Flags] =
    CALCULATE ( COUNTROWS ( 'FactDataQuality' ), 'FactDataQuality'[CheckType] = "Logical consistency" )
    , FormatString = "#,##0"
    , DisplayFolder = "5 Data quality"
    , Description = "Checks DQ01–DQ05 and DQ07: a value exceeds the value it should be a subset of."

MEASURE 'Measures'[Facility-Months with Logical Inconsistencies] =
    COUNTROWS ( SUMMARIZE ( FILTER ( 'FactDataQuality', 'FactDataQuality'[CheckType] = "Logical consistency" ), 'FactDataQuality'[FacilityKey], 'FactDataQuality'[MonthDate] ) )
    , FormatString = "#,##0"
    , DisplayFolder = "5 Data quality"
    , Description = "Distinct facility-months with at least one logical-consistency flag."

MEASURE 'Measures'[Under-5 Deaths] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), CALCULATE ( SUM ( 'FactMortality'[Deaths] ), REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "DTH_U5" ) )
    , FormatString = "#,##0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "Recorded under-5 deaths. Published at national-month level only (small numbers); blank whenever a facility, adopter or zone filter is active."

MEASURE 'Measures'[Maternal Deaths] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), CALCULATE ( SUM ( 'FactMortality'[Deaths] ), REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "DTH_MAT" ) )
    , FormatString = "#,##0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "Recorded maternal deaths. Published at national-month level only (small numbers); blank whenever a facility, adopter or zone filter is active."

MEASURE 'Measures'[Neonatal Deaths] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), CALCULATE ( SUM ( 'FactMortality'[Deaths] ), REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "DTH_NEO" ) )
    , FormatString = "#,##0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "Recorded neonatal deaths (first 28 days). Published at national-month level only (small numbers); blank whenever a facility, adopter or zone filter is active."

MEASURE 'Measures'[Infant Deaths] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), CALCULATE ( SUM ( 'FactMortality'[Deaths] ), REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "DTH_INF" ) )
    , FormatString = "#,##0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "Recorded infant deaths. Published at national-month level only (small numbers); blank whenever a facility, adopter or zone filter is active."

MEASURE 'Measures'[All-Category Deaths (Upper Bound)] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), CALCULATE ( SUM ( 'FactMortality'[Deaths] ), REMOVEFILTERS ( 'DimIndicator' ), 'DimIndicator'[IndicatorCode] = "DTH_ALL" ) )
    , FormatString = "#,##0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "Sum of the four mortality fields; an upper bound because one death may be entered in more than one field. Published at national-month level only (small numbers); blank whenever a facility, adopter or zone filter is active."

MEASURE 'Measures'[Deaths per 100 Reports] =
    IF ( ISFILTERED ( 'DimFacility' ) || ISFILTERED ( 'DimAdopter' ) || ISFILTERED ( 'DimGeography' ), BLANK (), DIVIDE ( [All-Category Deaths (Upper Bound)], [Reports Received] ) * 100 )
    , FormatString = "0.0"
    , DisplayFolder = "6 Mortality (national only)"
    , Description = "All-category deaths per 100 facility reports received. A facility-level event rate, not a population mortality rate."

MEASURE 'Measures'[General Attendance Previous Month] =
    CALCULATE ( [General Attendance], DATEADD ( 'DimDate'[Date], -1, MONTH ) )
    , FormatString = "#,##0"
    , DisplayFolder = "4 Time comparison"
    , Description = "General Attendance in the month before the month in context (use with one month selected / on a monthly axis)."

MEASURE 'Measures'[General Attendance MoM %] =
    VAR cur = [General Attendance]
    VAR prev = [General Attendance Previous Month]
    RETURN IF ( HASONEVALUE ( 'DimDate'[Month Start] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Month-on-month relative change in General Attendance. Blank for January (no prior month in the data)."

MEASURE 'Measures'[General Attendance QoQ %] =
    VAR cur = [General Attendance]
    VAR prev = CALCULATE ( [General Attendance], DATEADD ( 'DimDate'[Date], -1, QUARTER ) )
    RETURN IF ( HASONEVALUE ( 'DimDate'[Quarter Label] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Quarter-on-quarter relative change in General Attendance (Q2 vs Q1, Q3 vs Q2). Q3 2026 September reporting is incomplete – compare with General Attendance per Report."

MEASURE 'Measures'[ANC Visits Previous Month] =
    CALCULATE ( [ANC Visits], DATEADD ( 'DimDate'[Date], -1, MONTH ) )
    , FormatString = "#,##0"
    , DisplayFolder = "4 Time comparison"
    , Description = "ANC Visits in the month before the month in context (use with one month selected / on a monthly axis)."

MEASURE 'Measures'[ANC Visits MoM %] =
    VAR cur = [ANC Visits]
    VAR prev = [ANC Visits Previous Month]
    RETURN IF ( HASONEVALUE ( 'DimDate'[Month Start] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Month-on-month relative change in ANC Visits. Blank for January (no prior month in the data)."

MEASURE 'Measures'[ANC Visits QoQ %] =
    VAR cur = [ANC Visits]
    VAR prev = CALCULATE ( [ANC Visits], DATEADD ( 'DimDate'[Date], -1, QUARTER ) )
    RETURN IF ( HASONEVALUE ( 'DimDate'[Quarter Label] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Quarter-on-quarter relative change in ANC Visits (Q2 vs Q1, Q3 vs Q2). Q3 2026 September reporting is incomplete – compare with General Attendance per Report."

MEASURE 'Measures'[Skilled Birth Deliveries Previous Month] =
    CALCULATE ( [Skilled Birth Deliveries], DATEADD ( 'DimDate'[Date], -1, MONTH ) )
    , FormatString = "#,##0"
    , DisplayFolder = "4 Time comparison"
    , Description = "Skilled Birth Deliveries in the month before the month in context (use with one month selected / on a monthly axis)."

MEASURE 'Measures'[Skilled Birth Deliveries MoM %] =
    VAR cur = [Skilled Birth Deliveries]
    VAR prev = [Skilled Birth Deliveries Previous Month]
    RETURN IF ( HASONEVALUE ( 'DimDate'[Month Start] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Month-on-month relative change in Skilled Birth Deliveries. Blank for January (no prior month in the data)."

MEASURE 'Measures'[Skilled Birth Deliveries QoQ %] =
    VAR cur = [Skilled Birth Deliveries]
    VAR prev = CALCULATE ( [Skilled Birth Deliveries], DATEADD ( 'DimDate'[Date], -1, QUARTER ) )
    RETURN IF ( HASONEVALUE ( 'DimDate'[Quarter Label] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Quarter-on-quarter relative change in Skilled Birth Deliveries (Q2 vs Q1, Q3 vs Q2). Q3 2026 September reporting is incomplete – compare with General Attendance per Report."

MEASURE 'Measures'[FP Acceptors Previous Month] =
    CALCULATE ( [FP Acceptors], DATEADD ( 'DimDate'[Date], -1, MONTH ) )
    , FormatString = "#,##0"
    , DisplayFolder = "4 Time comparison"
    , Description = "FP Acceptors in the month before the month in context (use with one month selected / on a monthly axis)."

MEASURE 'Measures'[FP Acceptors MoM %] =
    VAR cur = [FP Acceptors]
    VAR prev = [FP Acceptors Previous Month]
    RETURN IF ( HASONEVALUE ( 'DimDate'[Month Start] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Month-on-month relative change in FP Acceptors. Blank for January (no prior month in the data)."

MEASURE 'Measures'[FP Acceptors QoQ %] =
    VAR cur = [FP Acceptors]
    VAR prev = CALCULATE ( [FP Acceptors], DATEADD ( 'DimDate'[Date], -1, QUARTER ) )
    RETURN IF ( HASONEVALUE ( 'DimDate'[Quarter Label] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
    , FormatString = "+0.0%;-0.0%;0.0%"
    , DisplayFolder = "4 Time comparison"
    , Description = "Quarter-on-quarter relative change in FP Acceptors (Q2 vs Q1, Q3 vs Q2). Q3 2026 September reporting is incomplete – compare with General Attendance per Report."

