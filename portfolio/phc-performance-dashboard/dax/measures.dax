MEASURE 'Measures'[Reporting Completeness MoM (pp)] =
    VAR cur = [Reporting Completeness %]
    VAR prev = CALCULATE ( [Reporting Completeness %], DATEADD ( 'DimDate'[Date], -1, MONTH ) )
    RETURN IF ( HASONEVALUE ( 'DimDate'[Month Start] ) && NOT ISBLANK ( prev ), ( cur - prev ) * 100 )
    , FormatString = "+0.0"" pp"";-0.0"" pp"";0.0"" pp"""
    , DisplayFolder = "4 Time comparison"
    , Description = "Change in reporting completeness versus the previous month, in percentage points."

MEASURE 'Measures'[Selected Period Label] =
    VAR mn = CALCULATE ( MIN ( 'FactFacilityReporting'[MonthDate] ) )
    VAR mx = CALCULATE ( MAX ( 'FactFacilityReporting'[MonthDate] ) )
    RETURN IF ( ISBLANK ( mn ), "No period", IF ( mn = mx, FORMAT ( mn, "mmmm yyyy" ), FORMAT ( mn, "mmm" ) & "–" & FORMAT ( mx, "mmm yyyy" ) ) )
    , DisplayFolder = "7 Labels & narrative"
    , Description = "Text label of the reporting months in context (based on months present in the facts, not the calendar)."

MEASURE 'Measures'[Executive Narrative] =
    VAR p = [Selected Period Label]
    VAR ga = [General Attendance]
    VAR topTbl =
        TOPN ( 1,
            FILTER ( ALL ( 'DimIndicator'[Indicator], 'DimIndicator'[ServiceCategory] ),
                NOT 'DimIndicator'[ServiceCategory] IN { "Service utilisation", "Family planning methods", "Mortality (national only)" } ),
            CALCULATE ( [Service Value] ), DESC )
    VAR topName = MAXX ( topTbl, 'DimIndicator'[Indicator] )
    RETURN
        IF ( ISBLANK ( ga ), "No facility reports match the current selection.",
            p & ": " & FORMAT ( ga, "#,##0" ) & " general attendance contacts were recorded from " & FORMAT ( [Reports Received], "#,##0" ) & " of " &
            FORMAT ( [Expected Reports], "#,##0" ) & " expected facility reports (" & FORMAT ( [Reporting Completeness %], "0.0%" ) & " reporting completeness). " &
            "Highest-volume indicator outside general/OPD attendance: " & topName & ". Figures are service contacts, not unique individuals; missing reports are not counted as zero." )
    , DisplayFolder = "7 Labels & narrative"
    , Description = "Dynamic executive summary built only from validated measures; updates with every slicer."

MEASURE 'Measures'[Contacts Not Individuals Note] =
    "Counts are service contacts / encounters, not unique individuals."
    , DisplayFolder = "7 Labels & narrative"
    , Description = "Static caption for KPI cards."

