{
  "name": "PHC Performance \u2013 Health Analytics",
  "dataColors": [
    "#1D4E89",
    "#0E7C86",
    "#3A9D5D",
    "#D98E04",
    "#7B5EA7",
    "#C8553D",
    "#6B7B8C",
    "#9DB4CC"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#13315C",
  "good": "#1E6B3A",
  "neutral": "#D98E04",
  "bad": "#B42318",
  "maximum": "#13315C",
  "center": "#9DB4CC",
  "minimum": "#F4F7FA",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#13315C"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#13315C"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#52606D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D5DDE5"
              }
            },
            "radius": 4
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#13315C"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#13315C"
              }
            },
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#52606D"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#13315C"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "textSize": 9
          }
        ]
      }
    }
  }
}